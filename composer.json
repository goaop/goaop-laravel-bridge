{
    "name": "goaop/goaop-laravel-bridge",
    "description": "Integration bridge for Go! AOP framework",
    "type": "library",
    "keywords": ["bridge", "laravel", "aop", "php", "aspect"],
    "license": "MIT",
    "authors": [
        {
            "name": "Lisachenko Alexander",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "goaop/framework": "^3.1",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Go\\Laravel\\GoAopBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Go\\Laravel\\GoAopBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Go\\Laravel\\GoAopBridge\\GoAopServiceProvider"
            ]
        }
    }
}
